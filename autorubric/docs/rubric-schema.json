          "type": "number"
        },
        "PARTIAL_CREDIT": {
          "default": 0.5,
          "title": "Partial Credit",
          "type": "number"
        },
        "NO_CREDIT": {
          "default": 0.0,
          "title": "No Credit",
          "type": "number"
        },
        "MISCONCEPTION": {
          "default": 0.0,
          "title": "Misconception",
          "type": "number"
        }
      },
      "title": "CreditMap",
      "type": "object"
    },
    "Criterion": {
