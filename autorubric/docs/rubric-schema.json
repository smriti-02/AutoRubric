      "required": [
        "id",
        "description",
        "weight"
      ],
      "title": "Criterion",
      "type": "object"
    }
  },
  "description": "A multi-criteria rubric with dependencies.",
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "criteria": {
